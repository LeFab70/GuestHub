generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(cuid())
  login                 String     @unique
  email                 String     @unique
  password              String
  nom                   String
  prenom                String
  role                  UserRole   @default(USER)
  isActive              Boolean    @default(true)
  lastLogin             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  passwordResetRequired Boolean    @default(false)
  auditLogs             AuditLog[]

  @@map("users")
}

model Department {
  id          String     @id @default(cuid())
  nom         String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@unique([nom, isActive])
  @@map("departments")
}

model Employee {
  id           String      @id @default(cuid())
  nom          String
  prenom       String
  email        String      @unique
  telephone    String?
  poste        String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  visits       Visite[]

  @@map("employees")
}

model Visitor {
  id            String   @id @default(cuid())
  nom           String
  prenom        String
  email         String?  @unique
  telephone     String?
  entreprise    String?
  estBlackliste Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  visits        Visite[]

  @@map("visitors")
}

model Visite {
  id         String      @id @default(cuid())
  dateDebut  DateTime
  dateFin    DateTime?
  motif      String
  statut     VisitStatus @default(PLANIFIEE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  visiteurId String
  employeId  String
  badges     Badge[]
  employe    Employee    @relation(fields: [employeId], references: [id])
  visiteur   Visitor     @relation(fields: [visiteurId], references: [id])

  @@map("visits")
}

model Badge {
  id        String    @id @default(cuid())
  qrCode    String    @unique
  etat      BadgeEtat @default(GENERE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  visiteId  String
  visite    Visite    @relation(fields: [visiteId], references: [id])

  @@map("badges")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String?
  dateHeure  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum UserRole {
  ADMIN
  RECEPTIONNISTE
  USER
}

enum VisitStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum BadgeEtat {
  GENERE
  EN_ATTENTE_VALIDATION
  IMPRIME
  VALIDE
  RENDU
  SCANNE
  AUTO_EXPIRE
}
