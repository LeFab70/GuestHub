generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(cuid())
  login                 String     @unique
  email                 String     @unique
  password              String
  nom                   String
  prenom                String
  role                  UserRole   @default(RECEPTIONNISTE)
  isActive              Boolean    @default(true)
  lastLogin             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  passwordResetRequired Boolean    @default(false)
  auditLogs             AuditLog[]
  // Relations
  printedBadges         Badge[]    @relation("BadgePrintedBy")

  @@map("users")
}

model Department {
  id          String     @id @default(cuid())
  nom         String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@unique([nom, isActive])
  @@map("departments")
}

model Employee {
  id           String      @id @default(cuid())
  nom          String
  prenom       String
  email        String      @unique
  telephone    String?
  poste        String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  visits       Visite[]

  @@map("employees")
}

model Visitor {
  id            String   @id @default(cuid())
  nom           String
  prenom        String
  email         String?  @unique
  telephone     String?
  entreprise    String?
  estBlackliste Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  visits        Visite[]

  @@map("visitors")
}

model Visite {
  id                String      @id @default(cuid())
  dateDebut         DateTime
  dateFin           DateTime?
  // New fields to explicitly capture time components if needed
  heureDebut        DateTime?
  heureFin          DateTime?
  motif             String
  statut            VisitStatus @default(CREEE)
  confirmByVisitor  String?     // Nom du visiteur qui a confirmé la visite
  confirmedAt       DateTime?   // Date de confirmation par le visiteur
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  visiteurId        String
  employeId         String
  // One-to-one relation with Badge
  badge             Badge?
  employe           Employee    @relation(fields: [employeId], references: [id])
  visiteur          Visitor     @relation(fields: [visiteurId], references: [id])

  @@map("visits")
}

model Badge {
  id             String     @id @default(cuid())
  qrCode         String     @unique
  status         BadgeStatus @default(GENERATED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  dateImpression DateTime?
  printById      String?
  printBy        User?      @relation("BadgePrintedBy", fields: [printById], references: [id])
  // One-to-one: each badge belongs to exactly one visit
  visiteId       String     @unique
  visite         Visite     @relation(fields: [visiteId], references: [id])

  // Deprecated fields (kept commented for reference)
  // nomVisiteur     String?
  // prenomVisiteur  String?
  // nomEmploye      String?
  // prenomEmploye   String?
  // nomDepartement  String?
  // dateUtilisation DateTime?
  // dateRetour      DateTime?

  @@map("badges")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String?
  dateHeure  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum UserRole {
  ADMIN
  RECEPTIONNISTE
}

enum VisitStatus {
  CREEE       // created just now
  PLANIFIEE   // future dateDebut
  EN_COURS    // in progress (badge printed)
  TERMINEE    // closed by checkout
  EXPIREE     // auto-expired (not scanned/closed by end of day)
}

enum BadgeStatus {
  GENERATED // for created/planified visits
  PRINTED   // when printed; set dateImpression & printBy
  CLOSED    // when visit ends or expires
}

model BadgeScanRecord {
  id            String   @id @default(cuid())
  qrCode        String
  action        String   // 'scan' or 'check-out'
  visitorName   String?
  employeeName  String?
  departmentName String?
  visitId       String?
  badgeId       String?
  scannedBy     String?  // User ID who performed the scan
  createdAt     DateTime @default(now())

  @@map("badge_scan_records")
}
