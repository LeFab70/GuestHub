// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id                    String   @id @default(cuid())
  login                 String   @unique
  email                 String   @unique
  password              String
  nom                   String
  prenom                String
  role                  UserRole @default(USER)
  isActive              Boolean  @default(true)
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  auditLogs AuditLog[]

  @@map("users")
}

// Department model
model Department {
  id          String   @id @default(cuid())
  nom         String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  employees Employee[]

  // Index pour permettre des noms similaires mais éviter les vrais doublons
  @@unique([nom, isActive])
  @@map("departments")
}

// Employee model
model Employee {
  id           String     @id @default(cuid())
  nom          String
  prenom       String
  email        String     @unique
  telephone    String?
  poste        String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Foreign keys
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Relations
  visits Visite[]

  @@map("employees")
}

// Visitor model
model Visitor {
  id            String   @id @default(cuid())
  nom           String
  prenom        String
  email         String?  @unique
  telephone     String?
  entreprise    String?
  estBlackliste Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  visits Visite[]

  @@map("visitors")
}

// Visit model
model Visite {
  id        String      @id @default(cuid())
  dateDebut DateTime
  dateFin   DateTime?
  motif     String
  statut    VisitStatus @default(PLANIFIEE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Foreign keys
  visiteurId String
  visiteur   Visitor  @relation(fields: [visiteurId], references: [id])
  employeId  String
  employe    Employee @relation(fields: [employeId], references: [id])

  // Relations
  badges Badge[]

  @@map("visits")
}

// Badge model
model Badge {
  id        String     @id @default(cuid())
  qrCode    String     @unique
  etat      BadgeEtat  @default(GENERE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Foreign keys
  visiteId String
  visite   Visite @relation(fields: [visiteId], references: [id])

  @@map("badges")
}

// Audit Log model
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String?
  dateHeure  DateTime @default(now())

  // Foreign keys
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// Enums
enum UserRole {
  ADMIN
  RECEPTIONNISTE
  USER
}

enum VisitStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum BadgeEtat {
  GENERE
  EN_ATTENTE_VALIDATION
  IMPRIME
  VALIDE
  RENDU
  SCANNE
  AUTO_EXPIRE
}
